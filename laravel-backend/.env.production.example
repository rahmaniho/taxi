APP_NAME="تاکسی کارن · کارن‌سافت"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://taxi.karen-soft.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ————— پایگاه‌داده MySQL در cPanel —————
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANELUSER_taxi
DB_USERNAME=CPANELUSER_taxi
DB_PASSWORD="CHANGE_ME_DB_PASSWORD"

# ————— نشست و کوکی (اختصاصی برای taxi.karen-soft.ir بدون تداخل با سایر زیردامنه‌ها) —————
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_COOKIE=taxi_karen_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ————— تنظیمات ایمیل (برای بازیابی رمز و یادآور تمدید اشتراک) —————
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.karen-soft.ir
MAIL_PORT=465
MAIL_USERNAME=noreply@karen-soft.ir
MAIL_PASSWORD="CHANGE_ME_MAIL_PASSWORD"
MAIL_FROM_ADDRESS="noreply@karen-soft.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ————— تنظیمات اشتراک و درگاه پرداخت —————
# ثبت‌نام عمومی بسته است؛ ساخت آژانس فقط از پنل مدیر کل انجام می‌شود
TAXI_PUBLIC_SIGNUP=false
TAXI_TRIAL_DAYS=14
TAXI_PAYMENT_GATEWAY=manual
TAXI_BANK_HOLDER=""
TAXI_BANK_CARD=""
TAXI_BANK_ACCOUNT=""
TAXI_BANK_SHEBA=""
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# ————— حساب اولیهٔ مدیر کل (سوپرادمین) هنگام اجرای migrate --seed —————
TAXI_MANAGER_NAME="مدیر کل تاکسی کارن"
TAXI_MANAGER_EMAIL=admin@karen-soft.ir
TAXI_MANAGER_PASSWORD="CHANGE_ME_STRONG_ADMIN_PASSWORD"
