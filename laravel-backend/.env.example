APP_NAME="تاکسی کارن · کارن‌سافت"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=taxi_auth
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_COOKIE=taxi_karen_session
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@karen-soft.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ————— تنظیمات اشتراک و پرداخت —————
# ثبت‌نام خودکار عمومی به‌صورت پیش‌فرض غیرفعال است (ساخت آژانس توسط مدیر کل)
TAXI_PUBLIC_SIGNUP=false
TAXI_TRIAL_DAYS=14
TAXI_PAYMENT_GATEWAY=manual
TAXI_BANK_HOLDER=
TAXI_BANK_CARD=
TAXI_BANK_ACCOUNT=
TAXI_BANK_SHEBA=
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# حساب مدیر کل فقط با seed ساخته می‌شود و تنها اگر این دو مقدار پر باشند
TAXI_MANAGER_NAME="مدیر کل"
TAXI_MANAGER_EMAIL=
TAXI_MANAGER_PASSWORD=
